msgstr "عرض أكثر %(shown)s استخدامًا من %(total)s جهة - استخدم بحث القسم للبقية"

#: templates/file/File_Management_Analysis_System.html:296
msgid "Filter from date"
msgstr "تصفية من تاريخ"

#: templates/file/File_Management_Analysis_System.html:297
msgid "Filter to date"
msgstr "تصفية"

