msgstr "عرض أكثر %(shown)s استخدامًا من %(total)s مصدرًا - استخدم بحث القسم للبقية"

#: templates/file/File_Management_Analysis_System.html:284
msgid "Filter by Side"
msgstr "تصفية"

#: templates/file/File_Management_Analysis_System.html:291
#, python-format
msgid ""
"Showing the %(shown)s most-used of %(total)s sides - use the section search "
