msgstr "%(label)s نمی‌تواند شامل شکست خط یا نویسه تهی باشد."

#: Api/routes/setup.py:40
#, python-format
msgid "%(label)s is required."
msgstr "%(label)s الزامی است."

#: Api/routes/setup.py:42
#, python-format
msgid "%(label)s must be no more than %(n)s characters."
msgstr "%(label)s نباید بیش از %(n)s نویسه باشد."

#: Api/routes/setup.py:50 Api/routes/setup.py:54
#, python-format
msgid "%(label)s must be a whole number."
msgstr "%(label)s باید یک عدد صحیح باشد."

#: Api/routes/setup.py:56
#, python-format
msgid "%(label)s must be between %(minimum)s and %(maximum)s."
msgstr "%(label)s باید بین %(minimum)s و %(maximum)s باشد."

#: Api/routes/setup.py:229
msgid ""
"System is already initialized. Re-installation is not permitted through this"
" endpoint."
msgstr "سامانه قبلاً راه‌اندازی شده است. نصب مجدد از این نقطه مجاز نیست."

