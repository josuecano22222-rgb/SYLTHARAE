msgstr "حوزه"

#: templates/Retention/retention.html:48
msgid "What it is"
msgstr "این چیست"

#: templates/Retention/retention.html:49
msgid "Keep (days)"
msgstr "نگه‌داری (روز)"

#: templates/Retention/retention.html:50
